{
  "//": "==============================",
  "enabled": true,
  "//layout": "karaoke | static | sentence",
  "mode": "sentence",
  "//max_words_per_line": "Controls line breaking before wrapping",
  "max_words_per_line": 4,
  "//max_lines": "Total lines visible at once (2 = 2x2 layout)",
  "max_lines": 2,
  "//word_visibility": "all | active-only",
  "word_visibility": "all",
  "//hold_previous_words": "Keeps past words visible until sentence ends",
  "hold_previous_words": true,
  "//pause_aware": "If true, subtitles stay on screen during short pauses",
  "pause_aware": true,
  "//pause_threshold_ms": "Pause duration considered a break",
  "pause_threshold_ms": 400,
  "//alignment": "bottom_center | center | top_center",
  "alignment": "bottom_center",
  "//margin_vertical_px": "Distance from bottom/top depending on alignment",
  "margin_vertical_px": 200,
  "//margin_horizontal_px": "Left/right safe margin",
  "margin_horizontal_px": 120,
  "//line_spacing_px": "Vertical spacing between lines",
  "line_spacing_px": 12,
  "//word_spacing_px": "Horizontal spacing between words",
  "word_spacing_px": 8,
  "font": {
    "family": "Arial",
    "size": 60,
    "weight": "bold",
    "//inactive_word_color": "Color for non-highlighted words",
    "inactive_color": "#FFFFFF",
    "//inactive_opacity": "0\u20131",
    "inactive_opacity": 0.85
  },
  "highlight": {
    "enabled": true,
    "//highlight_mode": "word | syllable",
    "mode": "word",
    "//text_color": "Color of active word",
    "text_color": "#FFD700",
    "//background_enabled": "Draw background box only for active word",
    "background_enabled": true,
    "//background_color": "Behind active word only",
    "background_color": "#0A1A2F",
    "//background_opacity": "0\u20131",
    "background_opacity": 0.9,
    "//background_padding_px": "Padding inside highlight box",
    "padding_x": 14,
    "padding_y": 6,
    "//corner_radius_px": "Rounded corners",
    "corner_radius_px": 8,
    "//transition_ms": "Fade in/out for highlight",
    "transition_ms": 80
  },
  "//enable_fade": "Fade subtitles in/out",
  "enable_fade": true,
  "//fade_in_ms": "Fade-in duration",
  "fade_in_ms": 120,
  "//fade_out_ms": "Fade-out duration",
  "fade_out_ms": 120,
  "//highlight_pop": "Subtle scale animation on active word",
  "highlight_pop": {
    "enabled": true,
    "scale": 1.05,
    "duration_ms": 90
  },
  "//min_word_duration_ms": "Lower bound to avoid flicker",
  "min_word_duration_ms": 120,
  "//max_word_duration_ms": "Upper bound for slow speech",
  "max_word_duration_ms": 900,
  "//extend_last_word_ms": "Extra hold on final word",
  "extend_last_word_ms": 200,
  "logo": {
    "//": "Logo display settings. Path is provided via CLI argument, not here.",
    "enabled": true,
    "//corner": "Placement corner: top-left | top-right | bottom-left | bottom-right",
    "corner": "bottom-right",
    "//width_pct": "Logo width as fraction of output frame width (1080px). 0.12 = ~130px wide.",
    "width_pct": 0.12,
    "//margin_x": "Horizontal margin in pixels from the chosen edge",
    "margin_x": 30,
    "//margin_y": "Vertical margin in pixels from the chosen edge",
    "margin_y": 30,
    "//opacity": "0.0 = invisible, 1.0 = fully opaque",
    "opacity": 0.85
  }
}
